# Database (PostgreSQL via asyncpg or SQLite for tests)
DATABASE_URL=postgresql+asyncpg://admin:secret@localhost:5432/diary

# Security
SECRET_KEY=change-this-to-a-very-secret-random-key-in-production-min-32-chars
# Optional dedicated encryption key for sensitive data (auto-derived from SECRET_KEY if left blank)
ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# First admin (used only when the database has no users)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Environment (development / production)
ENVIRONMENT=development
PORT=8010
TIMEZONE=Asia/Almaty

# Homework older than this many days is deleted automatically
HOMEWORK_RETENTION_DAYS=30

# Web Push notifications (generate a pair with: uv run locus-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
